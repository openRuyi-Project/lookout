{
  "name": "openruyi-tracker-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MulanPSL-2.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "start": "node server.mjs",
    "check": "astro check",
    "test": "npm run build && node tests/render.mjs",
    "lint": "eslint .",
    "unused": "knip",
    "boundaries": "depcruise --config dependency-cruiser.config.mjs src --include-only \"^src/\"",
    "quality": "npm run lint && npm run unused && npm run boundaries",
    "duplicates": "cd .. && jscpd --config .jscpd.json --no-gitignore --fail-on-empty --no-tips",
    "duplicates:similar": "npm run duplicates -- --min-lines 5 --min-tokens 50 --ignore-identifiers",
    "postinstall": "node scripts/harden-http-cache.cjs",
    "prebuild": "node scripts/harden-http-cache.cjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "astro": "7.3.2",
    "compression": "1.8.2",
    "htmx.org": "2.0.11",
    "http-cache-semantics": "4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "24.13.5",
    "typescript": "^5.9.3",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "typescript-eslint": "8.71.0",
    "knip": "6.39.0",
    "dependency-cruiser": "18.5.0",
    "openapi-typescript": "7.13.0",
    "jscpd": "5.4.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  }
}
