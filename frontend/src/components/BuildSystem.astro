---
import {listingURL} from '../lib/listing';
interface Props {value: string | null; filters?: URLSearchParams}
const {value, filters = new URLSearchParams()} = Astro.props;
---
{value && <span class="buildsystem-line"><a class="buildsystem-label" data-buildsystem={encodeURIComponent(value)} href={listingURL(filters, {buildsystem: value})} aria-label={`BuildSystem ${value}: show packages`}>{value}</a></span>}
