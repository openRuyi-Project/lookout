---
interface Props {value: string | null; query?: string; view?: string; maintenance?: string}
const {value, query = '', view = 'all', maintenance = ''} = Astro.props;
const href = '/?' + new URLSearchParams({buildsystem: value || '', q: query, view, maintenance});
---
{value && <span class="buildsystem-line"><a class="buildsystem-label" data-buildsystem={encodeURIComponent(value)} href={href} aria-label={`BuildSystem ${value}: show packages`}>{value}</a></span>}
