---
import type {Evidence} from '../lib/api.generated';

interface Props {facts: Evidence[]}
const {facts} = Astro.props;
const value = (fact: Evidence) => {
  if (fact.status !== 'observed') return fact.status.replaceAll('_', ' ');
  if (Array.isArray(fact.value)) return fact.value.join(', ') || '—';
  if (typeof fact.value === 'boolean') return fact.value ? 'Yes' : 'No';
  return fact.value ?? '—';
};
---
<dl class="evidence-facts">
  {facts.map(fact => <>
    <dt>{fact.key} <a href={fact.url}>{fact.source}</a></dt>
    <dd>{value(fact)}</dd>
  </>)}
</dl>
