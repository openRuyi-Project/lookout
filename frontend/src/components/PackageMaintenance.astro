---
import type {PackageDetail} from '../lib/api';
import {listingURL} from '../lib/listing';
import {utcTime} from '../lib/time';
import SecurityEvidence from './SecurityEvidence.astro';
import EvidenceFacts from './EvidenceFacts.astro';

interface Props {pkg: PackageDetail}
const {pkg} = Astro.props;
const security = pkg.maintenance_findings.filter(finding => finding.label === 'Security');
const other = pkg.maintenance_findings.filter(finding => finding.label !== 'Security');
const aggregate = (label: string) => listingURL(new URLSearchParams(), {maintenance: label});
---
{pkg.maintenance_findings.length > 0 && (
  <section aria-labelledby="maintenance-heading">
    <h2 id="maintenance-heading">Maintenance</h2>
    {security.length > 0 && <SecurityEvidence findings={security}/>}
    {other.length > 0 && (
      <div class="table-wrap">
        <table class="maintenance-table">
          <thead><tr><th scope="col">Type</th><th scope="col">Evidence</th></tr></thead>
          <tbody>
            {other.map(finding => (
              <tr id={'finding-' + encodeURIComponent(finding.id)}>
                <th scope="row">
                  <a href={aggregate(finding.label)}>{finding.label}</a>
                  {finding.tags.map(tag => <><br/><a class="state error" href={aggregate(tag)}>{tag}</a></>)}
                </th>
                <td>
                  <a href={finding.evidence_url}>{finding.title}</a>
                  {finding.scope === 'upgrade' && <p>Target {finding.target_version}</p>}
                  <EvidenceFacts facts={finding.facts}/>
                  {finding.stale && <small>Earlier observation; check status below.</small>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
)}
{pkg.monitor_checks.length > 0 && (
  <details class="monitor-checks">
    <summary>Checks</summary>
    <dl>
      {pkg.monitor_checks.map(check => <>
        <dt>{check.monitor}</dt>
        <dd>
          {check.status}
          {check.checked_at && <> · <time datetime={check.checked_at}>{utcTime(check.checked_at)} UTC</time></>}
          {check.note && <p>{check.note}</p>}
          {check.error && <p>{check.error}</p>}
        </dd>
      </>)}
    </dl>
  </details>
)}
