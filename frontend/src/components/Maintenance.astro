---
import type {MaintenanceLabel} from '../lib/api.generated';
import {listingURL} from '../lib/listing';
interface Props {labels: MaintenanceLabel[]; filters?: URLSearchParams; monitor?: string}
const {labels, filters = new URLSearchParams(), monitor = ''} = Astro.props;
---
{labels.length > 0 && <span class="maintenance-labels">{labels.map(label => <a
  class:list={['maintenance-label', {old: label.stale}]}
  href={listingURL(filters, {maintenance: label.label, monitor, check: ''})}
  title={label.stale ? 'Previous evidence; check details for freshness.' : undefined}
>{label.label}{label.count > 1 && <span>{label.count}</span>}</a>)}</span>}
