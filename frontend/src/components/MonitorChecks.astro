---
import type {MonitoredDetail} from '../lib/api.generated';
import {utcTime} from '../lib/time';
interface Props {monitors: MonitoredDetail['monitors']}
const {monitors} = Astro.props;
---
<details class="monitor-checks">
  <summary>Checks</summary>
  <dl>{Object.values(monitors).map(({title, check}) => <>
    <dt>{title}</dt><dd>
      {check.status}
      {check.checked_at && <> · <time datetime={check.checked_at}>{utcTime(check.checked_at)} UTC</time></>}
      {check.note && <p>{check.note}</p>}
      {check.error && <p>{check.error}</p>}
    </dd>
  </>)}</dl>
</details>
