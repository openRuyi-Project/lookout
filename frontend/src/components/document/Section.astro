---
import type {Section} from '../../lib/document';
import Fields from './Fields.astro';
import Entries from './Entries.astro';
import Table from './Table.astro';
interface Props {section: Section}
const {section} = Astro.props;
const Container = section.collapsible ? 'details' : 'section';
const Heading = section.collapsible ? 'summary' : 'h2';
---
<Container class="document-section" id={section.id}>
  {(section.title || section.collapsible) && <Heading>{section.title}</Heading>}
  <Fields fields={section.fields} compact/>
  {section.notes.map(note => <p class="section-note">{note}</p>)}
  {section.table && <Table table={section.table}/>}
  <div class="section-entries">
    <Entries section={section}/>
  </div>
</Container>
