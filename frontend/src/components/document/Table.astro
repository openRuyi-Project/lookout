---
import {noteRows, type Table} from '../../lib/document';
import Values from './Values.astro';
import NavigationMenu from './NavigationMenu.astro';
interface Props {table: Table}
const {table} = Astro.props;
const columnIDs = table.columns.map((_, index) => `column-${encodeURIComponent(table.label)}-${index}`);
const wide = table.columns.some(column => column.role === 'status');
const statusMatrix = table.columns[0]?.role === 'identity' && table.columns.length > 1
  && table.columns.slice(1).every(column => column.role === 'status');
---
<div class:list={['table-wrap', {wide}]} role="region" tabindex="0" aria-label={table.label}>
  <table class:list={['data-table', {wide, 'status-matrix': statusMatrix}]}>
    <colgroup>{table.columns.map(column => <col class={`column-${column.role}`}/>)}</colgroup>
    <thead><tr>{table.columns.map((column, index) => <th id={columnIDs[index]} scope="col" class={`column-${column.role}`}>
      {column.navigation.some(menu => menu.choices.length)
        ? <NavigationMenu title={column.title} menus={column.navigation}
            id={`table-${encodeURIComponent(table.label)}-${index}-menu`}/>
        : column.title}
    </th>)}</tr></thead>
    {table.rows.map((row, rowIndex) => <tbody>
    <tr data-key={row.key} id={row.id || undefined}>
      {row.cells.map((cell, index) => {
        const Tag = index === 0 ? 'th' : 'td';
        return <Tag scope={index === 0 ? 'row' : undefined}
          id={index === 0 ? `row-${encodeURIComponent(table.label)}-${rowIndex}` : undefined}
          class={`column-${table.columns[index].role}`}>
          {cell.lines.length ? cell.lines.map(line => <div class="value-line"><Values values={line}/></div>) : <span class="tone-muted">—</span>}
        </Tag>;
      })}
    </tr>
    {noteRows(row.notes, table.columns.length).map(notes => <tr class="row-note">
      {notes.map(note => <td colspan={note.span} aria-hidden={note.values.length ? undefined : 'true'}
        headers={note.values.length ? `row-${encodeURIComponent(table.label)}-${rowIndex} ${columnIDs.slice(note.column, note.column + note.span).join(' ')}` : undefined}>
        {note.values.length > 0 && <div class="value-line"><Values values={note.values}/></div>}
      </td>)}
    </tr>)}
    </tbody>)}
  </table>
</div>
{!table.rows.length && <p class="empty">{table.empty}</p>}
