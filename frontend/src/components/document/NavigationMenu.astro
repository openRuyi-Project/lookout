---
import type {Navigation} from '../../lib/document';
import Links from './Navigation.astro';
interface Props {title: string; menu: Navigation; id: string}
const {title, menu, id} = Astro.props;
---
<button type="button" class="navigation-menu-trigger" popovertarget={id} aria-label={`Filter ${title}`}>
  {title} <span aria-hidden="true">▾</span>
</button>
<div id={id} popover="auto" class="navigation-menu"><Links navigation={menu}/></div>
