---
import Icon from './Icon.astro';
import {safeHref, type Text} from '../../lib/document';
interface Props {values: Text[]}
const {values} = Astro.props;
---
{values.map(value => {
  const href = safeHref(value.href);
  const Tag = href ? 'a' : value.kind === 'time' ? 'time' : 'span';
  return <Tag href={href} title={value.title || undefined}
    class:list={['value', `value-${value.kind}`, `tone-${value.tone}`]}
    datetime={value.datetime || undefined}
    data-variant={value.kind === 'tag' ? value.variant : undefined}
    data-decoration={value.decoration || undefined}
    data-appearance={value.appearance ? encodeURIComponent(value.appearance) : undefined}>{value.icon && <Icon name={value.icon}/>}{value.kind === 'icon' && value.icon ? <span class="visually-hidden">{value.text}</span> : value.text}</Tag>;
})}
