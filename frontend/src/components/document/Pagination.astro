---
import {safeHref, type ListingDocument} from '../../lib/document';
interface Props {
  page: Pick<ListingDocument, 'total' | 'page' | 'pages' | 'pagination'>;
  label: string;
}
const {page, label} = Astro.props;
---
<nav class="pagination" aria-label={label}>
  <span>{page.total} {page.total === 1 ? 'package' : 'packages'} · page {page.page} / {page.pages}</span>
  {page.pagination.map(choice => <a href={safeHref(choice.href)}>{choice.label}</a>)}
</nav>
