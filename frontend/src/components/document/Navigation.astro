---
import {safeHref, type Navigation} from '../../lib/document';
interface Props {navigation: Navigation; rail?: boolean}
const {navigation, rail = false} = Astro.props;
---
<nav class:list={['document-nav', {rail}]} aria-label={navigation.label}>
  {navigation.choices.map(choice => <a href={safeHref(choice.href)} aria-current={choice.selected ? 'page' : undefined}>
    <span>{choice.label}</span>{choice.count != null && <b>{choice.count}</b>}
  </a>)}
</nav>
