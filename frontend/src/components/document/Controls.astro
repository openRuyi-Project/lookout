---
import {safeHref, type Controls} from '../../lib/document';
import Navigation from './Navigation.astro';
interface Props {controls: Controls}
const {controls} = Astro.props;
---
<div class="document-controls">
  {controls.navigation.length > 0 && <div class="control-bar">{controls.navigation.map(navigation => <Navigation navigation={navigation}/>)}</div>}
  {controls.choice_rows.length > 0 && <div class="choice-rows">{controls.choice_rows.map(navigation =>
    <div class="choice-row">{navigation.show_label && <span class="choice-row-label">{navigation.icon && <span class="choice-row-icon" aria-hidden="true">{navigation.icon}</span>}{navigation.label}</span>}<Navigation navigation={navigation}/></div>
  )}</div>}
  {controls.active.length > 0 && <div class="active-filters">{controls.active.map(choice =>
    <a href={safeHref(choice.href)} aria-label={`Remove ${choice.label}`}>{choice.label} <span aria-hidden="true">×</span></a>
  )}</div>}
</div>
