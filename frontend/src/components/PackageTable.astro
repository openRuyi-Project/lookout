---
import type {Listing} from '../lib/api';
import {renderer} from '../monitors/registry';
import {tableLayout} from '../monitors/layout';
import {checkLabel} from '../lib/checks';
import {utcTime} from '../lib/time';
import {listingURL} from '../lib/listing';
interface Props {data: Listing; query: URLSearchParams}
const {data, query} = Astro.props;
const layout = tableLayout(data.monitors, query.get('monitor') || '');
const focus = data.monitors.find(m => m.id === query.get('monitor'));
const coverage = !!focus && data.section === 'coverage';
const columns = coverage ? [] : [
  ...layout.columns.map(monitor => ({monitor, target: undefined, label: monitor.title})),
  ...layout.targets.flatMap(monitor => data.targets.map(target => ({monitor, target, label: target.label}))),
];
const columnCount = coverage ? 3 : columns.length + 1;
---
<div class="table-wrap" role="region" tabindex="0" aria-label="Package monitors; scroll horizontally">
  <table class:list={['package-table', {focused: !!focus, coverage}]} data-columns={columnCount}>
    <caption class="sr-only">Source packages and monitor observations</caption>
    <colgroup>
      <col class="identity-column"/>
      {coverage && <><col/><col class="checked-column"/></>}
      {columns.map(column => <col class={column.target ? undefined : 'observation-column'}/>)}
    </colgroup>
    <thead><tr>
      <th scope="col">Package</th>
      {coverage && <><th scope="col">Status</th><th scope="col">Last checked</th></>}
      {columns.map(column => <th scope="col" class={column.target ? 'build' : undefined}>{column.label}</th>)}
    </tr></thead>
    <tbody>{data.items.map(pkg => {
      const focused = pkg.monitors[query.get('monitor') || ''];
      return <tr data-name={pkg.name}>
      <th scope="row">
        <span class="package-identity">
          <a class="pkg" href={pkg.detail_url}>{pkg.name}</a>
          {layout.identity.map(monitor => {
            const {Summary} = renderer(monitor);
            return <Summary result={pkg.monitors[monitor.id]} pkg={pkg} filters={query}/>;
          })}
        </span>
        {layout.signals.map(monitor => {
          const {Summary} = renderer(monitor);
          return <Summary result={pkg.monitors[monitor.id]} pkg={pkg} filters={query}/>;
        })}
      </th>
      {coverage && focused && <>
        <td><span title={focused.check.note || undefined}>{checkLabel(focused.check.status)}</span>
          {focused.check.error && <small class="monitor-status">{focused.check.error}</small>}</td>
        <td>{focused.check.checked_at ? <time datetime={focused.check.checked_at}>{utcTime(focused.check.checked_at)} UTC</time> : '—'}</td>
      </>}
      {columns.map(({monitor, target}) => {
        const {Summary} = renderer(monitor);
        const result = pkg.monitors[monitor.id];
        return <td class={target ? 'build' : undefined} data-target={target?.id}>
          <Summary result={result} pkg={pkg} filters={query} target={target} focused={!!query.get('monitor')}/>
        </td>;
      })}
    </tr>;})}
    {data.total === 0 && <tr><td class="empty" colspan={columnCount}>
      {focus?.kind === 'evidence' && !coverage ? <>No recorded findings for this selection. <a href={listingURL(query, {section: 'coverage', check: ''})}>View coverage</a></> : 'No matching packages.'}
    </td></tr>}
    </tbody>
  </table>
</div>
