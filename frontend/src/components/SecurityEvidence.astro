---
import type {Finding} from '../lib/api.generated';
import EvidenceFacts from './EvidenceFacts.astro';
interface Props {findings: Finding[]}
const {findings} = Astro.props;
const common = (findings[0]?.facts ?? []).filter(f => f.code === 'query' &&
  findings.every(item => item.facts.some(other => JSON.stringify(other) === JSON.stringify(f))));
const commonKeys = new Set(common.map(f => JSON.stringify(f)));
const fixed = (finding: Finding) => [...new Set(finding.facts.filter(f => f.code === 'fixed_events' &&
  f.status === 'observed').flatMap(f => Array.isArray(f.value) ? f.value : []))];
const probabilities = (finding: Finding) => finding.facts.filter(f =>
  f.code === 'epss_probability' && f.status === 'observed' && typeof f.value === 'number');
const incomplete = (finding: Finding) => finding.facts.some(f => f.status === 'unavailable');

---
<details class="security-evidence">
  <summary>Security {findings.length}{findings.some(incomplete) && <small> · Incomplete evidence</small>}{findings.some(f => f.stale) && <small> · Earlier observations</small>}</summary>
  {common.length > 0 && <p class="security-query">{[...new Set(common.map(f => f.source))].join(', ')} · {common.map(f => String(f.value)).join(' / ')}</p>}
  <table class="security-table"><thead><tr><th>Advisory</th><th>Fixed events</th><th>EPSS</th></tr></thead><tbody>
    {findings.map(f => <tr id={'finding-' + encodeURIComponent(f.id)}>
      <td><a href={f.evidence_url}>{f.title}</a>{f.tags.includes('KEV') && <> · <a href="/?maintenance=KEV">KEV</a></>}
        {incomplete(f) && <small> · Incomplete</small>}
        <details class="advisory-evidence"><summary>Evidence</summary>
          <EvidenceFacts facts={f.facts.filter(fact => !commonKeys.has(JSON.stringify(fact)))}/>
          {f.stale && <small>Earlier observation; check status below.</small>}
        </details>
      </td>
      <td>{fixed(f).join(', ') || '—'}</td>
      <td>{probabilities(f).map(p => `${(Number(p.value) * 100).toFixed(3).replace(/\.?0+$/, '')}%`).join(', ') || '—'}</td>
    </tr>)}
  </tbody></table>
  <details class="detail-note security-scope"><summary>Scope</summary>Queried source component only. Local patch applicability, bundled dependencies and binary artifacts are not evaluated.</details>
</details>
