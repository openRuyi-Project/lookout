---
import type {Listing} from '../lib/api';
import {listingURL} from '../lib/listing';
interface Props {data: Listing; query: URLSearchParams}
const {data, query} = Astro.props;
const focus = query.get('monitor') || '';
---
<nav class="filters monitor-nav" aria-label="Monitors">
  <a href={listingURL(query, {monitor: '', check: '', section: ''})} aria-current={!focus ? 'page' : undefined}>Overview</a>
  {data.monitors.map(m => <a href={listingURL(query, {monitor: m.id, check: '', section: ''})}
    aria-current={m.id === focus ? 'page' : undefined}>{m.title}</a>)}
</nav>
