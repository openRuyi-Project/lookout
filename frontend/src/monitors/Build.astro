---
import type {Props} from './registry';
import type {Build, BuildDetail} from '../lib/api.generated';
import BuildStatus from '../components/BuildStatus.astro';
import {utcTime} from '../lib/time';
const {result, pkg, target, detail = false} = Astro.props as Props;
const data = result.data;
const builds: Array<Build | BuildDetail> = data.kind === 'build' ? data.targets : [];
const selected = builds.find(build => build.target === target?.id);
const rows = builds.flatMap(build =>
  ('flavors' in build && build.flavors.length > 1 ? build.flavors : [build]).map(observation => ({
    ...observation, label: build.label, flavor: 'package' in observation ? observation.package : null,
  })));
---
{detail ? <>

<section aria-labelledby="build-status">
  <h2 id="build-status">Build status</h2>
  <p class="updated-note">Last updated: <span>OBS {result.check.checked_at ? <time datetime={result.check.checked_at}>{utcTime(result.check.checked_at)}</time> : '—'}</span> <span class="time-zone">UTC</span></p>
  <div class="table-wrap" role="region" tabindex="0" aria-label="Build status by target">
    <table class="detail-table">
      <thead>
        <tr>
          <th scope="col">Target</th>
          <th scope="col">Result</th>
          <th scope="col">Last successful version</th>
          <th scope="col">Succeeded at (UTC)</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(build => {
          const Status = build.log_url ? 'a' : 'span';
          const missingVersion = build.last_success
            ? 'OBS recorded a successful build, but its version could not be resolved.'
            : 'No last-success record is available for this observation.';
          return (
            <tr>
              <th scope="row">
                {build.label}
                {build.flavor && <span class="build-flavor">{build.flavor}</span>}
              </th>
              <td>
                <Status class:list={['state', build.kind]} href={build.log_url || undefined}
                  title={`OBS ${build.raw_status}. Last updated: ${utcTime(build.updated_at)} UTC.`}>
                  {build.text}
                </Status>
              </td>
              <td><strong title={build.last_success?.version ? undefined : missingVersion}>{build.last_success?.version || '—'}</strong></td>
              <td class="build-success-time">
                {build.last_success?.time ? <time datetime={build.last_success.time}>{utcTime(build.last_success.time)}</time> : '—'}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>

</> : selected && data.kind === 'build' && <BuildStatus build={selected} name={pkg.name} current={data.source_version} detailURL={pkg.detail_url}/>}
