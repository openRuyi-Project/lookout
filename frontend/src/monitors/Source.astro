---
import type {Props} from './registry';
import BuildSystem from '../components/BuildSystem.astro';
const {result, filters, detail = false, focused = false} = Astro.props as Props;
const data = result.data;
const meta = data.kind === 'source' && 'metadata' in data ? data.metadata : null;
const changelog = data.kind === 'source' && 'changelog' in data ? data.changelog : [];
const day = (iso: string) => iso.slice(0, 10);
---
{data.kind === 'source' && (detail && 'metadata' in data ? <section>
    <h2>Package information</h2>
    <dl class="general">
      {meta?.summary && <><dt>Summary</dt><dd>{meta.summary}</dd></>}
      {meta?.license && <><dt>License</dt><dd>{meta.license}</dd></>}
      <dt>SPEC Source</dt><dd>{data.source_url ? <a href={data.source_url}>/{data.source_path}</a> : <span>/{data.source_path}</span>}</dd>
      {meta?.url && <><dt>Upstream</dt><dd><a href={meta.url}>{meta.url}</a></dd></>}

      {!data.buildsystem && <><dt>BuildSystem</dt><dd><abbr title={data.buildsystem_status === 'not_declared' ? 'The parsed SPEC does not declare BuildSystem.' : 'The SPEC observation is missing or failed; declaration is unknown.'}>NotDetected</abbr></dd></>}
    </dl>
    {meta?.description && <details class="description"><summary>Description</summary><p>{meta.description}</p></details>}

    <h2>Changelog</h2>
    {data.error && !changelog.length && <p class="detail-note">Changelog unavailable: {data.error}</p>}
    {changelog.length > 0
      ? <ol class="changelog">{changelog.map(c => <li>
          <div class="cl-head"><span class="cl-subject">{c.subject}</span><time class="cl-date">{day(c.date)}</time></div>
          <div class="cl-meta">{c.author}{c.signed_off_by.length > 0 && <span class="cl-sob"> · Signed-off-by: {c.signed_off_by.join(', ')}</span>}</div>
        </li>)}</ol>
      : (!data.error && <p class="detail-note">No SPEC history recorded yet.</p>)}

</section> : <>
  {focused && <span class="current-version">{data.version || '—'}</span>}
  <BuildSystem value={data.buildsystem} filters={filters}/>
</>)}
