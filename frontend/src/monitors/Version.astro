---
import type {Props} from './registry';
import Version from '../components/Version.astro';
const {result, pkg, detail = false} = Astro.props as Props;
const data = result.data;
const build = pkg.monitors.build?.data;
const success = build?.kind === 'build' ? build.source_success : null;
const watched = data.kind === 'version' && 'watch' in data ? data.watch : [];
---
{data.kind === 'version' && <>
  <Version version={data} sourceSuccess={success} label={detail}/>
  {detail && watched.length > 0 && <dl class="general" aria-label="Explicitly watched tracks">
    <dt>Watching</dt><dd><ul>{watched.map(w => <li>
      <a href={`/api/v1/tracks/${encodeURIComponent(w.id)}`}>{w.id}</a>: <strong>{w.version || '—'}</strong>
      {w.version && (w.error || w.stale) && <span title={w.error || 'Observation has expired'}> (last observed)</span>}
    </li>)}</ul></dd>
  </dl>}
</>}
