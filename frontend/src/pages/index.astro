---
import Base from '../layouts/Base.astro';
import PackageFilters from '../components/PackageFilters.astro';
import PackageTable from '../components/PackageTable.astro';
import {utcTime} from '../lib/time';
import {api, type Listing} from '../lib/api';
import {listingQuery, listingURL} from '../lib/listing';

const query = listingQuery(Astro.url.searchParams);
const {data, status} = await api<Listing>('/api/v2/packages?' + query);
const invalidFilters = status === 422;
if (!data) Astro.response.status = invalidFilters ? 422 : 503;
---
<Base>
  <section aria-label="Package list">
    <PackageFilters data={data} query={query}/>
    {!data && (
      <div role="alert" class="notice">
        {invalidFilters ? <>Invalid filter selection. <a href="/">Clear filters</a></>
          : <>Snapshot unavailable. <a href={listingURL(query)}>Retry</a></>}
      </div>
    )}
    {data?.collection.mode === 'fixture' && <div class="notice">Test fixture — not live openRuyi data.</div>}
    {data && <>
      <PackageTable data={data} query={query}/>
      <p class="updated-note">Last updated: <span>OBS {data.collection.obs_updated_at ? <time datetime={data.collection.obs_updated_at}>{utcTime(data.collection.obs_updated_at)}</time> : '—'}</span> · <span>Upstream {data.collection.upstream_updated_at ? <time datetime={data.collection.upstream_updated_at}>{utcTime(data.collection.upstream_updated_at)}</time> : '—'}</span> <span class="time-zone">UTC</span></p>
      <nav class="pagination" aria-label="Pages">
        <span>{data.total} packages · page {data.page} / {Math.max(data.pages, 1)}</span>
        {data.page > 1 && <a rel="prev" href={listingURL(query, {page: String(data.page - 1)})}>Previous</a>}
        {data.page < data.pages && <a rel="next" href={listingURL(query, {page: String(data.page + 1)})}>Next</a>}
      </nav>
    </>}
  </section>
  <script is:inline src="/filters.js" defer></script>
</Base>
