---
import Base from '../layouts/Base.astro';
import Controls from '../components/document/Controls.astro';
import Table from '../components/document/Table.astro';
import Navigation from '../components/document/Navigation.astro';
import Fields from '../components/document/Fields.astro';
import {api} from '../lib/api';
import {safeHref, type ListingDocument} from '../lib/document';
const {data, status} = await api<ListingDocument>('/api/ui/packages' + Astro.url.search);
if (!data) Astro.response.status = status === 422 ? 422 : 503;
---
<Base>
  {data ? <div class="workspace">
    <aside class="monitor-rail"><span class="rail-label">Monitors</span><Navigation navigation={data.navigation} rail/></aside>
    <section class="listing" aria-label="Package list">
      <header class="listing-heading"><h1>{data.title}</h1></header>
      <Controls controls={data.controls}/>
      {data.notices.map(notice => <p class="notice">{notice}</p>)}
      <Table table={data.table}/>
      <nav class="pagination" aria-label="Pages"><span>{data.total} packages · page {data.page} / {data.pages}</span>
        {data.pagination.map(choice => <a href={safeHref(choice.href)}>{choice.label}</a>)}
      </nav>
      <div class="collection-meta"><Fields fields={data.meta} compact/></div>
    </section>
  </div> : <div role="alert" class="notice">{status === 422 ? 'Invalid filter selection.' : 'Snapshot unavailable.'} <a href="/">Packages</a></div>}
  <script is:inline src="/filters.js" defer></script>
</Base>
