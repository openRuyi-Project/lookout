---
import Base from '../../layouts/Base.astro';
import MonitorChecks from '../../components/MonitorChecks.astro';
import {api, type PackageDetail} from '../../lib/api';
import {renderer} from '../../monitors/registry';
import {detailLayout} from '../../monitors/layout';
const name = Astro.params.name || '';
const apiPath = '/api/v2/packages/' + encodeURIComponent(name);
const response = await api<PackageDetail>(apiPath);
const pkg = response.data;
if (!pkg) Astro.response.status = response.status === 404 ? 404 : 503;
const modules = Object.values(pkg?.monitors || {});
const descriptors = modules.map(m => ({id: m.id, title: m.title, kind: m.data.kind}));
---
<Base title={`${name} · openRuyi Packages`}>
  <section class="package-detail"><a class="back" href="/">← Packages</a>
  {pkg ? <>
    <header class="package-heading">
      <h1>{pkg.name}</h1>
      {descriptors.filter(m => renderer(m).placement === 'identity').map(m => {
        const {Summary} = renderer(m); return <Summary result={pkg.monitors[m.id]} pkg={pkg}/>;
      })}
    </header>
    {detailLayout(descriptors).map(m => {
      const {Detail} = renderer(m); return <Detail result={pkg.monitors[m.id]} pkg={pkg} detail/>;
    })}
    <MonitorChecks monitors={pkg.monitors}/>
    <p class="provenance-link"><a href={apiPath}>Raw data (JSON)</a></p>
  </> : <div role="alert" class="notice">{response.status === 404 ? 'No such source package.' : 'Snapshot unavailable. Please try again later.'}</div>}
  </section>
</Base>
