[Unit]
Description=openRuyi Package Monitor

[Container]
Image=@IMAGE@
Pull=never
ContainerName=openruyi-monitor
UserNS=keep-id:uid=10001,gid=10001
User=10001
Group=10001
PublishPort=127.0.0.1:18730:8080
Volume=@CONFIG_DIR@:/config:ro,Z
Volume=@DATA_DIR@:/data:Z
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Tmpfs=/tmp:rw,nosuid,nodev,size=128m,mode=1777
Environment=HOST=0.0.0.0
Environment=PORT=8080
StopTimeout=20
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
