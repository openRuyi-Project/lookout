# Tests extend the exact application image; test libraries do not ship in it.
ARG RUNTIME_IMAGE
FROM ${RUNTIME_IMAGE}
USER 0
COPY backend/requirements-test.lock /tmp/requirements-test.lock
RUN /opt/venv/bin/python -m ensurepip \
    && /opt/venv/bin/python -m pip install --no-cache-dir --upgrade pip==26.2.1 \
    && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements-test.lock \
    && rm /tmp/requirements-test.lock
# The generator is a development dependency, absent from the application image.
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc /app/frontend/
COPY frontend/scripts/harden-http-cache.cjs /app/frontend/scripts/
RUN node --version && npm --version \
    && cd /app/frontend && npm ci --ignore-scripts --no-audit --no-fund && npm run postinstall
USER 10001:10001
